{
  "info": {
    "name": "Credit Card Payment System API",
    "description": "Postman collection for the Credit Card Payment System assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "django_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "fastapi_url",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "card_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postmanuser\",\n  \"email\": \"postman@example.com\",\n  \"password\": \"Test@12345\"\n}"
            },
            "url": {
              "raw": "{{django_url}}/api/users/register/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"access_token\", pm.response.json().access);",
                  "pm.collectionVariables.set(\"refresh_token\", pm.response.json().refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postmanuser\",\n  \"password\": \"Test@12345\"\n}"
            },
            "url": {
              "raw": "{{django_url}}/api/users/login/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/users/me/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Protected Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/users/protected/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "users",
                "protected"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "Add Test Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"card_id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_type\": \"CREDIT\",\n  \"card_number\": \"4111111111111111\",\n  \"cvv\": \"123\",\n  \"expiry_month\": 12,\n  \"expiry_year\": 2029\n}"
            },
            "url": {
              "raw": "{{django_url}}/api/cards/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "cards"
              ]
            }
          }
        },
        {
          "name": "View Cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/cards/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "cards"
              ]
            }
          }
        },
        {
          "name": "Add Balance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000\n}"
            },
            "url": {
              "raw": "{{django_url}}/api/cards/{{card_id}}/add-balance/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "cards",
                "{{card_id}}",
                "add-balance"
              ]
            }
          }
        },
        {
          "name": "Delete Card",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/cards/{{card_id}}/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "cards",
                "{{card_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Simulated Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"card_id\": {{card_id}},\n  \"amount\": 100\n}"
            },
            "url": {
              "raw": "{{fastapi_url}}/payments/",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "payments"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/transactions/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            }
          }
        },
        {
          "name": "Failed Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/transactions/?status=FAILED",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "FAILED"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/users/admin-dashboard/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "users",
                "admin-dashboard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "FastAPI",
      "item": [
        {
          "name": "FastAPI Root",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{fastapi_url}}/",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                ""
              ]
            }
          }
        },
        {
          "name": "FastAPI Database Test",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{fastapi_url}}/db-test",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "db-test"
              ]
            }
          }
        }
      ]
    }
  ]
}